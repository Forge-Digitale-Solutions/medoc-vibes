# Node
NODE_ENV=development

NEXT_PUBLIC_API_URL=http://localhost:3333

# Waitlist + /contact → Web3Forms (clé serveur, jamais exposée au navigateur)
# 1. Créer une access key sur https://web3forms.com (e-mail destinataire: contact@medocvibes.fr)
# 2. Coller la clé dans Dokploy → service site → Environment → WEB3FORMS_ACCESS_KEY
# 3. Redeploy le conteneur (runtime env — pas besoin de rebuild image)
WEB3FORMS_ACCESS_KEY=
