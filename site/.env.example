# Node
NODE_ENV=development

NEXT_PUBLIC_API_URL=http://localhost:3333

# Waitlist + /contact → Resend (clé serveur, jamais commitée / jamais NEXT_PUBLIC)
# 1. Créer une API key sur https://resend.com/api-keys (remplace re_xxxxxxxxx)
# 2. Dokploy → service site → Environment → RESEND_API_KEY
# 3. Redeploy (runtime — pas de rebuild image)
RESEND_API_KEY=

# Optionnel
# CONTACT_TO_EMAIL=contact@medocvibes.fr
# RESEND_FROM_EMAIL=Médoc Vibes <onboarding@resend.dev>
# Après vérif DNS medocvibes.fr : RESEND_FROM_EMAIL=Médoc Vibes <contact@medocvibes.fr>
