# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App — générer localement : node ace generate:key
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Base de données
#--------------------------------------------------------------------
# Par défaut le scaffold utilise SQLite local (tmp/db.sqlite3) —
# aucune Postgres locale n'est requise pour booter / lire la doc.
#
# En prod (Dokploy / infra partagée), définir DATABASE_URL vers Postgres :
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/medoc_vibes
#
# Ou variables Lucid classiques (si connection pg activée) :
# DB_CONNECTION=pg
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=medoc
# DB_PASSWORD=
# DB_DATABASE=medoc_vibes

#--------------------------------------------------------------------
# CORS (origines autorisées pour ops / site / apps)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:4310,http://localhost:4311
