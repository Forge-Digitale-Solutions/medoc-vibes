# Node
TZ=UTC
# Local default. In Dokploy, PORT is injected / mapped by the platform — do not hardcode prod port.
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App — generate locally: node ace generate:key
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Database (Postgres + PostGIS — default local path)
#--------------------------------------------------------------------
# Start DB: docker compose up -d
# Then: cp .env.example .env && node ace generate:key
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=medoc
DB_PASSWORD=medoc
DB_DATABASE=medoc_vibes

# Alternative (Dokploy / infra shared Postgres):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/medoc_vibes

#--------------------------------------------------------------------
# Ingest stubs (not required for feed MVP)
#--------------------------------------------------------------------
# DATATOURISME_API_KEY=
# OPENAGENDA_API_KEY=

#--------------------------------------------------------------------
# CORS (ops / site / apps)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:4310,http://localhost:4311